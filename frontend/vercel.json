{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/_/backend/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|_/backend/).*)",
      "destination": "/index.html"
    }
  ]
}